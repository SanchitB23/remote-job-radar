

# =========================================
# Remote Job Radar API - Environment Configuration
# =========================================
# Copy this file to .env (or .env.local for development) and fill in your values.

# --- Database ---
PG_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require  # Set your DB connection string

# PostgreSQL LISTEN/NOTIFY Connection Settings (optional - defaults provided)
PG_LISTENER_RECONNECT_INTERVAL=5000  # Base reconnection interval in milliseconds
PG_LISTENER_MAX_RECONNECT_ATTEMPTS=50  # Maximum reconnection attempts
PG_LISTENER_CONNECTION_TIMEOUT=30000  # Connection timeout in milliseconds
PG_LISTENER_KEEPALIVE_DELAY=30000  # TCP keepalive initial delay in milliseconds

# --- Clerk Authentication ---
CLERK_JWK_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# --- CORS ---
GQL_API_CORS_ORIGIN=http://localhost:3000  # Comma-separated list of allowed origins

# --- Server ---
GQL_API_BASE_URL="http://localhost:4000"  # Base URL for API
GQL_API_PORT=4000  # Port for API server
EMBEDDER_BASE_URL="http://localhost:8000"  # Base URL for Embedder API